[gd_scene load_steps=4 format=3]

; PLANTILLA CANONICA DEL CONTRATO DE ARTE (docs/ART_SWAP_CONTRACT.md).
; Duplicar esta escena para cada personaje/enemigo/criatura/NPC.
; El arte final SOLO reemplaza el subarbol bajo "Visual/". El codigo referencia
; Collision, AnimationPlayer y los Marker3D — nunca la malla del arte.
; Escala: 1 unidad = 1 metro. Mira a -Z. Pivote en los pies (origen a ras).

[ext_resource type="Material" path="res://art_placeholders/mat_player.tres" id="1_mat"]

[sub_resource type="CapsuleShape3D" id="shape_body"]
radius = 0.35
height = 1.6

[sub_resource type="CapsuleMesh" id="mesh_body"]
radius = 0.35
height = 1.6

[node name="Actor" type="CharacterBody3D"]

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
shape = SubResource("shape_body")

[node name="Visual" type="Node3D" parent="."]

[node name="Placeholder" type="MeshInstance3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
mesh = SubResource("mesh_body")
surface_material_override/0 = ExtResource("1_mat")

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]

[node name="Muzzle" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, -0.5)

[node name="Hand" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.3, 1, 0)

[node name="Head" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.7, 0)
